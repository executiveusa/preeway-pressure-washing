---
import { getLangFromUrl, getTranslations } from '../i18n/index';
import { getPrimaryImageForSection, getAlt, getCaption, type SupportedLang } from '../lib/images';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);

const quoteImg = getPrimaryImageForSection('quote-flow');
const quoteAlt = quoteImg ? getAlt(quoteImg, lang as SupportedLang) : '';
const quoteCaption = quoteImg ? getCaption(quoteImg, lang as SupportedLang) : '';
---

<section id="quote" class="py-24 bg-dark">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    {quoteImg && (
      <div class="mb-12 grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div class="rounded-lg overflow-hidden border border-surface-2">
          <img
            src={quoteImg.path}
            alt={quoteAlt}
            width={quoteImg.width}
            height={quoteImg.height}
            loading={quoteImg.loading}
            decoding="async"
            class="w-full object-cover"
            style="max-height: 360px; object-position: center 20%;"
          />
        </div>
        <div>
          <p class="font-mono text-gold text-xs tracking-widest uppercase mb-3">How It Works</p>
          <p class="font-body text-text/80 text-lg leading-relaxed italic mb-2">{quoteCaption}</p>
          <p class="font-body text-muted text-sm">No commitment required. We review every request before sending a quote.</p>
        </div>
      </div>
    )}
    <div class="text-center mb-12">
      <p class="font-mono text-gold text-xs tracking-widest uppercase mb-4">Get Started</p>
      <h2 class="font-display italic text-3xl sm:text-4xl lg:text-5xl text-text mb-6">
        {t.form.heading}
      </h2>
      <p class="font-body text-muted text-lg">{t.form.sub}</p>
    </div>

    <div class="bg-surface border border-surface-2 rounded-xl p-6 sm:p-10">
      <form id="quote-form" novalidate>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

          <!-- Name -->
          <div class="sm:col-span-1">
            <label for="q-name" class="block font-mono text-xs text-muted tracking-widest uppercase mb-2">
              {t.form.name} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="q-name"
              name="name"
              placeholder={t.form.name_placeholder}
              required
              autocomplete="name"
              class="w-full bg-dark border border-surface-2 focus:border-gold/60 text-text font-body text-sm px-4 py-3 rounded outline-none transition-colors placeholder:text-muted/40"
            />
          </div>

          <!-- Phone -->
          <div class="sm:col-span-1">
            <label for="q-phone" class="block font-mono text-xs text-muted tracking-widest uppercase mb-2">
              {t.form.phone} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <input
              type="tel"
              id="q-phone"
              name="phone"
              placeholder={t.form.phone_placeholder}
              required
              autocomplete="tel"
              class="w-full bg-dark border border-surface-2 focus:border-gold/60 text-text font-body text-sm px-4 py-3 rounded outline-none transition-colors placeholder:text-muted/40"
            />
          </div>

          <!-- Email -->
          <div class="sm:col-span-2">
            <label for="q-email" class="block font-mono text-xs text-muted tracking-widest uppercase mb-2">
              {t.form.email} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="q-email"
              name="email"
              placeholder={t.form.email_placeholder}
              required
              autocomplete="email"
              class="w-full bg-dark border border-surface-2 focus:border-gold/60 text-text font-body text-sm px-4 py-3 rounded outline-none transition-colors placeholder:text-muted/40"
            />
          </div>

          <!-- Property Type -->
          <div class="sm:col-span-1">
            <label for="q-property" class="block font-mono text-xs text-muted tracking-widest uppercase mb-2">
              {t.form.property_type} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <select
              id="q-property"
              name="property_type"
              required
              class="w-full bg-dark border border-surface-2 focus:border-gold/60 text-text font-body text-sm px-4 py-3 rounded outline-none transition-colors appearance-none"
            >
              <option value="" disabled selected>—</option>
              <option value="residential">{t.form.property_types.residential}</option>
              <option value="commercial">{t.form.property_types.commercial}</option>
              <option value="hoa">{t.form.property_types.hoa}</option>
              <option value="civic">{t.form.property_types.civic}</option>
            </select>
          </div>

          <!-- City -->
          <div class="sm:col-span-1">
            <label for="q-city" class="block font-mono text-xs text-muted tracking-widest uppercase mb-2">
              {t.form.city} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="q-city"
              name="city"
              placeholder={t.form.city_placeholder}
              required
              class="w-full bg-dark border border-surface-2 focus:border-gold/60 text-text font-body text-sm px-4 py-3 rounded outline-none transition-colors placeholder:text-muted/40"
            />
          </div>

          <!-- Service Needed -->
          <div class="sm:col-span-1">
            <label for="q-service" class="block font-mono text-xs text-muted tracking-widest uppercase mb-2">
              {t.form.service} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <select
              id="q-service"
              name="service"
              required
              class="w-full bg-dark border border-surface-2 focus:border-gold/60 text-text font-body text-sm px-4 py-3 rounded outline-none transition-colors appearance-none"
            >
              <option value="" disabled selected>—</option>
              <option value="graffiti">{t.form.services.graffiti}</option>
              <option value="mural">{t.form.services.mural}</option>
              <option value="pressure">{t.form.services.pressure}</option>
              <option value="storefront">{t.form.services.storefront}</option>
              <option value="driveway">{t.form.services.driveway}</option>
              <option value="coating">{t.form.services.coating}</option>
              <option value="other">{t.form.services.other}</option>
            </select>
          </div>

          <!-- Surface Type -->
          <div class="sm:col-span-1">
            <label for="q-surface" class="block font-mono text-xs text-muted tracking-widest uppercase mb-2">
              {t.form.surface}
            </label>
            <select
              id="q-surface"
              name="surface"
              class="w-full bg-dark border border-surface-2 focus:border-gold/60 text-text font-body text-sm px-4 py-3 rounded outline-none transition-colors appearance-none"
            >
              <option value="" disabled selected>—</option>
              <option value="concrete">{t.form.surfaces.concrete}</option>
              <option value="brick">{t.form.surfaces.brick}</option>
              <option value="siding">{t.form.surfaces.siding}</option>
              <option value="wood">{t.form.surfaces.wood}</option>
              <option value="metal">{t.form.surfaces.metal}</option>
              <option value="stone">{t.form.surfaces.stone}</option>
              <option value="other">{t.form.surfaces.other}</option>
            </select>
          </div>

          <!-- Urgency -->
          <div class="sm:col-span-2">
            <label for="q-urgency" class="block font-mono text-xs text-muted tracking-widest uppercase mb-2">
              {t.form.urgency} <span class="text-gold" aria-hidden="true">*</span>
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              {[
                { val: 'emergency', label: t.form.urgencies.emergency },
                { val: 'urgent', label: t.form.urgencies.urgent },
                { val: 'standard', label: t.form.urgencies.standard },
                { val: 'planning', label: t.form.urgencies.planning },
              ].map(({ val, label }) => (
                <label class="urgency-option flex items-center gap-2 p-3 border border-surface-2 rounded cursor-pointer hover:border-gold/40 transition-colors has-[:checked]:border-gold has-[:checked]:bg-gold/5">
                  <input type="radio" name="urgency" value={val} class="hidden" />
                  <div class="w-3 h-3 rounded-full border-2 border-surface-2 flex-shrink-0 urgency-dot"></div>
                  <span class="font-body text-muted text-xs">{label}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Photo upload -->
          <div class="sm:col-span-2">
            <label for="q-photo" class="block font-mono text-xs text-muted tracking-widest uppercase mb-2">
              {t.form.photo}
            </label>
            <div class="border border-dashed border-surface-2 hover:border-gold/30 rounded-lg p-6 text-center transition-colors cursor-pointer" onclick="document.getElementById('q-photo').click()">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8a9e7e" stroke-width="1.5" stroke-linecap="round" class="mx-auto mb-3" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/>
              </svg>
              <p class="font-body text-muted text-sm mb-1">Click to upload photos</p>
              <p class="font-mono text-muted/50 text-xs">{t.form.photo_hint}</p>
            </div>
            <input
              type="file"
              id="q-photo"
              name="photos"
              accept="image/*"
              multiple
              class="hidden"
              aria-label={t.form.photo}
            />
          </div>

          <!-- Message -->
          <div class="sm:col-span-2">
            <label for="q-message" class="block font-mono text-xs text-muted tracking-widest uppercase mb-2">
              {t.form.message}
            </label>
            <textarea
              id="q-message"
              name="message"
              rows={4}
              placeholder={t.form.message_placeholder}
              class="w-full bg-dark border border-surface-2 focus:border-gold/60 text-text font-body text-sm px-4 py-3 rounded outline-none transition-colors resize-none placeholder:text-muted/40"
            ></textarea>
          </div>
        </div>

        <div class="mt-8">
          <button
            type="submit"
            id="quote-submit"
            class="w-full bg-gold hover:bg-gold-light text-dark font-body font-bold text-base py-4 rounded transition-all duration-200 hover:shadow-lg hover:shadow-gold/20 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {t.form.submit}
          </button>
        </div>

        <p class="mt-4 text-center font-mono text-muted/50 text-xs">
          {t.form.required} fields marked <span class="text-gold">*</span>
        </p>
      </form>

      <!-- Success state -->
      <div id="quote-success" class="hidden text-center py-12">
        <div class="w-16 h-16 bg-accent-green/10 border border-accent-green/30 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#5a7a52" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <polyline points="20,6 9,17 4,12"/>
          </svg>
        </div>
        <h3 class="font-display italic text-2xl text-text mb-3">{t.form.success_heading}</h3>
        <p class="font-body text-muted mb-4">{t.form.success_body}</p>
        <p id="quote-ref-id" class="font-mono text-gold text-sm"></p>
      </div>

      <!-- Error state -->
      <div id="quote-error" class="hidden mt-4 p-4 border border-red-500/30 bg-red-500/5 rounded-lg">
        <p class="font-body text-red-400 text-sm text-center">{t.form.error}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('quote-submit') as HTMLButtonElement | null;
  const successEl = document.getElementById('quote-success');
  const errorEl = document.getElementById('quote-error');
  const refIdEl = document.getElementById('quote-ref-id');

  // Urgency radio visual
  document.querySelectorAll<HTMLElement>('.urgency-option').forEach((label) => {
    const input = label.querySelector('input[type="radio"]');
    const dot = label.querySelector('.urgency-dot');
    input?.addEventListener('change', () => {
      document.querySelectorAll('.urgency-dot').forEach((d) => {
        (d as HTMLElement).style.backgroundColor = '';
        (d as HTMLElement).style.borderColor = '';
      });
      if (dot) {
        (dot as HTMLElement).style.backgroundColor = '#c4963c';
        (dot as HTMLElement).style.borderColor = '#c4963c';
      }
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    submitBtn.disabled = true;
    const originalText = submitBtn.textContent ?? '';
    submitBtn.textContent = 'Sending...';
    errorEl?.classList.add('hidden');

    const data = Object.fromEntries(new FormData(form).entries());

    try {
      const res = await fetch('/api/quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (!res.ok) throw new Error('Request failed');

      const json = await res.json() as { success: boolean; id: string };

      if (json.success) {
        form.classList.add('hidden');
        if (refIdEl) refIdEl.textContent = json.id;
        successEl?.classList.remove('hidden');
      } else {
        throw new Error('Server error');
      }
    } catch {
      errorEl?.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>
