---
import { getLangFromUrl, getTranslations } from '../i18n/index';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const basePath = lang === 'es' ? '/es' : '';
---

<section id="artists" class="py-24 bg-surface relative overflow-hidden">
  <!-- Decorative background element -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at 70% 50%, rgba(90,122,82,0.08) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left: Visual representation of mural -->
      <div class="order-2 lg:order-1">
        <div class="relative">
          <!-- Mural simulation with CSS art -->
          <div
            class="w-full aspect-square max-w-md mx-auto rounded-lg overflow-hidden relative"
            style="background: linear-gradient(135deg, #1a2a1a 0%, #0a1a0a 100%);"
            role="img"
            aria-label="Abstract representation of mural art"
          >
            <!-- Mural-like abstract art using CSS/SVG -->
            <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" class="w-full h-full" aria-hidden="true">
              <!-- Background layers -->
              <rect width="400" height="400" fill="#0a1a0a"/>
              <!-- Abstract mural shapes -->
              <ellipse cx="200" cy="300" rx="180" ry="60" fill="#1a2a1a"/>
              <!-- Large sweeping forms -->
              <path d="M50 350 Q100 200 200 150 Q300 100 380 200 L400 400 L0 400 Z" fill="#243a24" opacity="0.8"/>
              <!-- Figure suggestion -->
              <path d="M160 280 Q180 150 200 120 Q220 150 240 280" stroke="#5a7a52" stroke-width="3" fill="none" opacity="0.6"/>
              <circle cx="200" cy="100" r="25" fill="#5a7a52" opacity="0.5"/>
              <!-- Gold accent strokes (representing mural detail) -->
              <path d="M80 200 Q150 160 220 180 Q290 200 340 170" stroke="#c4963c" stroke-width="2" fill="none" opacity="0.4"/>
              <path d="M60 250 Q160 210 260 230 Q330 245 380 220" stroke="#c4963c" stroke-width="1.5" fill="none" opacity="0.3"/>
              <!-- Community symbols -->
              <path d="M120 320 L140 290 L160 320 L120 320 Z" fill="#c4963c" opacity="0.6"/>
              <path d="M260 310 L280 280 L300 310 L260 310 Z" fill="#5a7a52" opacity="0.5"/>
              <!-- "PROTECTED" watermark-style text -->
              <text x="200" y="370" text-anchor="middle" font-family="monospace" font-size="10" fill="#5a7a52" opacity="0.4" letter-spacing="6">PROTECTED</text>
              <!-- Subtle grid overlay -->
              <line x1="0" y1="133" x2="400" y2="133" stroke="#5a7a52" stroke-width="0.5" opacity="0.15"/>
              <line x1="0" y1="266" x2="400" y2="266" stroke="#5a7a52" stroke-width="0.5" opacity="0.15"/>
              <line x1="133" y1="0" x2="133" y2="400" stroke="#5a7a52" stroke-width="0.5" opacity="0.15"/>
              <line x1="266" y1="0" x2="266" y2="400" stroke="#5a7a52" stroke-width="0.5" opacity="0.15"/>
            </svg>

            <!-- Overlay label -->
            <div class="absolute bottom-4 left-4 right-4">
              <div class="flex items-center gap-2 bg-dark/80 backdrop-blur-sm px-3 py-2 rounded">
                <div class="w-2 h-2 bg-accent-green rounded-full"></div>
                <span class="font-mono text-accent-green text-xs tracking-widest uppercase">Mural Recovery Network</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Content -->
      <div class="order-1 lg:order-2">
        <p class="font-mono text-gold text-xs tracking-widest uppercase mb-4">For Artists</p>
        <h2 class="font-display italic text-3xl sm:text-4xl lg:text-5xl text-text mb-6 leading-tight">
          {t.artist.heading}
        </h2>
        <p class="font-body text-muted text-lg mb-4 leading-relaxed italic">
          {t.artist.sub}
        </p>
        <p class="font-body text-muted/80 text-base mb-8 leading-relaxed">
          {t.artist.body}
        </p>

        <!-- Benefits list -->
        <ul class="space-y-3 mb-8" role="list">
          {t.artist.benefits.map((benefit) => (
            <li class="flex items-start gap-3">
              <div class="flex-shrink-0 w-5 h-5 mt-0.5 flex items-center justify-center">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <circle cx="8" cy="8" r="7" fill="#5a7a52" opacity="0.2"/>
                  <path d="M5 8 L7 10 L11 6" stroke="#5a7a52" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="font-body text-text/80 text-sm leading-relaxed">{benefit}</span>
            </li>
          ))}
        </ul>

        <!-- CTA -->
        <a
          href={`${basePath}/#quote`}
          class="inline-flex items-center gap-2 bg-accent-green hover:bg-accent-green/80 text-text font-body font-bold text-sm px-6 py-3 rounded transition-all duration-200"
        >
          {t.artist.cta}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 8 L13 8 M9 4 L13 8 L9 12"/>
          </svg>
        </a>

        <!-- Fine print -->
        <p class="font-body text-muted text-xs mt-4 leading-relaxed">
          {t.artist.fine_print}
        </p>
      </div>
    </div>
  </div>
</section>
