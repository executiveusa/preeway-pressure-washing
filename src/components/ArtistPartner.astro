---
import { getLangFromUrl, getTranslations } from '../i18n/index';
import { getPrimaryImageForSection, getImageById, getAlt, getCaption, type SupportedLang } from '../lib/images';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const basePath = lang === 'es' ? '/es' : '';

const artistImg = getPrimaryImageForSection('artist-partnership');
const muralRecoveryImg = getImageById('04_service_mural_recovery');
const primaryImg = artistImg ?? muralRecoveryImg;
const primaryAlt = primaryImg ? getAlt(primaryImg, lang as SupportedLang) : '';
const primaryCaption = primaryImg ? getCaption(primaryImg, lang as SupportedLang) : '';
---

<section id="artists" class="py-24 bg-surface relative overflow-hidden">
  <!-- Decorative background element -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at 70% 50%, rgba(90,122,82,0.08) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left: Mural artist photograph -->
      <div class="order-2 lg:order-1">
        <div class="relative w-full max-w-md mx-auto rounded-lg overflow-hidden border border-surface-2">
          {primaryImg ? (
            <>
              <img
                src={primaryImg.path}
                alt={primaryAlt}
                width={primaryImg.width}
                height={primaryImg.height}
                loading={primaryImg.loading}
                decoding="async"
                class="w-full object-cover"
                style="max-height: 480px; object-position: center 20%;"
              />
              <div class="absolute bottom-0 left-0 right-0 px-4 py-3 bg-gradient-to-t from-dark/90 to-transparent">
                <div class="flex items-center gap-2">
                  <div class="w-2 h-2 bg-accent-green rounded-full"></div>
                  <span class="font-mono text-accent-green text-xs tracking-widest uppercase">Mural Recovery Network</span>
                </div>
                {primaryCaption && (
                  <p class="font-body text-muted text-xs mt-1 leading-snug">{primaryCaption}</p>
                )}
              </div>
            </>
          ) : (
            <div class="w-full aspect-square bg-surface flex items-center justify-center">
              <span class="font-mono text-muted text-xs">Image pending upload</span>
            </div>
          )}
        </div>
      </div>

      <!-- Right: Content -->
      <div class="order-1 lg:order-2">
        <p class="font-mono text-gold text-xs tracking-widest uppercase mb-4">For Artists</p>
        <h2 class="font-display italic text-3xl sm:text-4xl lg:text-5xl text-text mb-6 leading-tight">
          {t.artist.heading}
        </h2>
        <p class="font-body text-muted text-lg mb-4 leading-relaxed italic">
          {t.artist.sub}
        </p>
        <p class="font-body text-muted/80 text-base mb-8 leading-relaxed">
          {t.artist.body}
        </p>

        <!-- Benefits list -->
        <ul class="space-y-3 mb-8" role="list">
          {t.artist.benefits.map((benefit) => (
            <li class="flex items-start gap-3">
              <div class="flex-shrink-0 w-5 h-5 mt-0.5 flex items-center justify-center">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <circle cx="8" cy="8" r="7" fill="#5a7a52" opacity="0.2"/>
                  <path d="M5 8 L7 10 L11 6" stroke="#5a7a52" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="font-body text-text/80 text-sm leading-relaxed">{benefit}</span>
            </li>
          ))}
        </ul>

        <!-- CTA -->
        <a
          href={`${basePath}/#quote`}
          class="inline-flex items-center gap-2 bg-accent-green hover:bg-accent-green/80 text-text font-body font-bold text-sm px-6 py-3 rounded transition-all duration-200"
        >
          {t.artist.cta}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 8 L13 8 M9 4 L13 8 L9 12"/>
          </svg>
        </a>

        <!-- Fine print -->
        <p class="font-body text-muted text-xs mt-4 leading-relaxed">
          {t.artist.fine_print}
        </p>
      </div>
    </div>
  </div>
</section>
