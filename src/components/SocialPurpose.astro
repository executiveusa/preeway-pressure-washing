---
import { getLangFromUrl, getTranslations } from '../i18n/index';
import { getPrimaryImageForSection, getAlt, type SupportedLang } from '../lib/images';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);

const socialImg = getPrimaryImageForSection('social-purpose');
const socialAlt = socialImg ? getAlt(socialImg, lang as SupportedLang) : '';
---

<section id="purpose" class="py-24 bg-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Left: Heading + explanation -->
      <div>
        <p class="font-mono text-gold text-xs tracking-widest uppercase mb-4">Our Mission</p>
        <h2 class="font-display italic text-3xl sm:text-4xl lg:text-5xl text-text mb-6 leading-tight">
          {t.purpose.heading}
        </h2>
        <p class="font-body text-muted text-lg mb-6 leading-relaxed">
          {t.purpose.sub}
        </p>
        <p class="font-body text-muted/80 text-base leading-relaxed mb-8">
          {t.purpose.spc_explain}
        </p>

        <!-- SPC badge block -->
        <div class="inline-flex items-center gap-3 px-5 py-3 bg-surface border border-accent-green/30 rounded-lg">
          <div class="w-3 h-3 bg-accent-green rounded-full"></div>
          <div>
            <div class="font-mono text-accent-green text-xs tracking-widest uppercase">Washington SPC</div>
            <div class="font-body text-muted text-xs mt-0.5">Legally embedded social mission</div>
          </div>
        </div>
      </div>

      <!-- Right: Community image + impact areas -->
      <div>
        {socialImg && (
          <div class="mb-10 rounded-lg overflow-hidden border border-surface-2">
            <img
              src={socialImg.path}
              alt={socialAlt}
              width={socialImg.width}
              height={socialImg.height}
              loading={socialImg.loading}
              decoding="async"
              class="w-full object-cover"
              style="max-height: 320px; object-position: center 30%;"
            />
            <div class="px-4 py-2 bg-surface flex items-center gap-2">
              <div class="w-2 h-2 bg-accent-green rounded-full"></div>
              <span class="font-mono text-muted text-xs tracking-widest uppercase">{socialImg.title[lang as SupportedLang] ?? socialImg.title.en}</span>
            </div>
          </div>
        )}
        <h3 class="font-display italic text-2xl text-gold mb-6">What Our SPC Status Means in Practice</h3>
        <ul class="space-y-4" role="list">
          {t.purpose.impact_areas.map((area) => (
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 mt-1">
                <div class="w-5 h-5 flex items-center justify-center">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8 L6.5 11.5 L13 4.5" stroke="#5a7a52" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
              <p class="font-body text-text/80 text-base leading-relaxed">{area}</p>
            </li>
          ))}
        </ul>

        <!-- Disclaimer -->
        <div class="mt-10 p-5 bg-surface-2 border border-surface-2 rounded-lg">
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 mt-0.5">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="7" stroke="#8a9e7e" stroke-width="1.5"/>
                <path d="M8 5 L8 9" stroke="#8a9e7e" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="8" cy="11.5" r="0.75" fill="#8a9e7e"/>
              </svg>
            </div>
            <p class="font-body text-muted text-xs leading-relaxed">
              {t.purpose.disclaimer}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
