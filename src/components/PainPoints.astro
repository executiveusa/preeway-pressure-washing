---
import { getLangFromUrl, getTranslations } from '../i18n/index';
import { getPrimaryImageForSection, getAlt, type SupportedLang } from '../lib/images';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);

const painImg = getPrimaryImageForSection('pain');
const painAlt = painImg ? getAlt(painImg, lang as SupportedLang) : '';
---

<section id="pain-points" class="py-24 bg-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <p class="font-mono text-gold text-xs tracking-widest uppercase mb-4">The Problem</p>
      <h2 class="font-display italic text-3xl sm:text-4xl lg:text-5xl text-text mb-6">
        {t.pain.heading}
      </h2>
      <p class="font-body text-muted text-lg max-w-2xl mx-auto">
        {t.pain.sub}
      </p>
    </div>

    <!-- Vandalized storefront evidence image -->
    {painImg && (
      <div class="mb-12 rounded-lg overflow-hidden border border-surface-2 max-w-2xl mx-auto">
        <img
          src={painImg.path}
          alt={painAlt}
          width={painImg.width}
          height={painImg.height}
          loading={painImg.loading}
          decoding="async"
          class="w-full object-cover"
          style="max-height: 300px; object-position: center 40%;"
        />
        <div class="px-4 py-2 bg-surface flex items-center justify-between gap-2">
          <span class="font-mono text-muted text-xs tracking-widest uppercase">{painImg.location.neighborhood} · {painImg.location.city}, {painImg.location.state}</span>
          <span class="font-mono text-gold/60 text-xs">before</span>
        </div>
      </div>
    )}

    <!-- Pain points grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {t.pain.points.map((point, i) => (
        <article class="group p-6 bg-surface border border-surface-2 rounded-lg hover:border-gold/30 transition-all duration-300 hover:bg-surface-2">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center mt-0.5">
              <span class="font-mono text-gold/40 text-xs">0{i + 1}</span>
            </div>
            <div>
              <h3 class="font-display italic text-xl text-text mb-3 group-hover:text-gold transition-colors">
                {point.title}
              </h3>
              <p class="font-body text-muted text-sm leading-relaxed">
                {point.desc}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
