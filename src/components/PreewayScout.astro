---
import { getLangFromUrl, getTranslations } from '../i18n/index';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
---

<section id="scout" class="py-24 bg-surface">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 border border-accent-green/30 rounded-full bg-accent-green/5">
        <div class="w-2 h-2 bg-accent-green rounded-full animate-pulse"></div>
        <span class="font-mono text-accent-green text-xs tracking-widest uppercase">AI-Assisted Routing</span>
      </div>
      <h2 class="font-display italic text-3xl sm:text-4xl lg:text-5xl text-text mb-6">
        {t.scout.heading}
      </h2>
      <p class="font-body text-muted text-lg max-w-2xl mx-auto">
        {t.scout.description}
      </p>
    </div>

    <!-- Scout interaction -->
    <div class="bg-dark border border-surface-2 rounded-xl overflow-hidden">
      <!-- Scout header bar -->
      <div class="flex items-center gap-3 px-6 py-4 bg-surface border-b border-surface-2">
        <div class="flex gap-1.5" aria-hidden="true">
          <div class="w-3 h-3 rounded-full bg-surface-2"></div>
          <div class="w-3 h-3 rounded-full bg-surface-2"></div>
          <div class="w-3 h-3 rounded-full bg-surface-2"></div>
        </div>
        <div class="flex items-center gap-2 ml-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5a7a52" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
          </svg>
          <span class="font-mono text-muted text-xs tracking-wide">preeway-scout · routing assistant</span>
        </div>
      </div>

      <!-- Scout body -->
      <div class="p-6 sm:p-8">
        <!-- Question -->
        <div class="flex items-start gap-4 mb-8">
          <div class="flex-shrink-0 w-8 h-8 bg-accent-green/20 border border-accent-green/30 rounded-full flex items-center justify-center">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5a7a52" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
            </svg>
          </div>
          <div>
            <p class="font-mono text-muted text-xs tracking-widest uppercase mb-2">Preeway Scout</p>
            <p class="font-body text-text text-base">{t.scout.sub}</p>
            <p class="font-body text-muted text-sm mt-2">{t.scout.classify_heading}</p>
          </div>
        </div>

        <!-- Classification buttons -->
        <div class="flex flex-col sm:flex-row gap-3 mb-8" id="scout-buttons" role="group" aria-label="Visitor type selection">
          <button
            data-type="property_owner"
            data-response={t.scout.responses.property_owner}
            class="scout-btn flex-1 px-4 py-3 border border-surface-2 hover:border-gold/50 text-muted hover:text-text font-body text-sm rounded-lg transition-all duration-200 text-left hover:bg-surface"
          >
            <span class="font-mono text-gold text-xs block mb-1">01</span>
            {t.scout.buttons.property_owner}
          </button>
          <button
            data-type="storefront_owner"
            data-response={t.scout.responses.storefront_owner}
            class="scout-btn flex-1 px-4 py-3 border border-surface-2 hover:border-gold/50 text-muted hover:text-text font-body text-sm rounded-lg transition-all duration-200 text-left hover:bg-surface"
          >
            <span class="font-mono text-gold text-xs block mb-1">02</span>
            {t.scout.buttons.storefront_owner}
          </button>
          <button
            data-type="sponsor"
            data-response={t.scout.responses.sponsor}
            class="scout-btn flex-1 px-4 py-3 border border-surface-2 hover:border-gold/50 text-muted hover:text-text font-body text-sm rounded-lg transition-all duration-200 text-left hover:bg-surface"
          >
            <span class="font-mono text-gold text-xs block mb-1">03</span>
            {t.scout.buttons.sponsor}
          </button>
        </div>

        <!-- Response area (hidden initially) -->
        <div id="scout-response" class="hidden">
          <div class="flex items-start gap-4 p-5 bg-accent-green/5 border border-accent-green/20 rounded-lg">
            <div class="flex-shrink-0 w-8 h-8 bg-gold/10 border border-gold/30 rounded-full flex items-center justify-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c4963c" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <polyline points="20,6 9,17 4,12"/>
              </svg>
            </div>
            <div>
              <p class="font-mono text-gold text-xs tracking-widest uppercase mb-2">Scout · Next Step</p>
              <p id="scout-response-text" class="font-body text-text text-sm leading-relaxed"></p>
              <a
                href="#quote"
                class="inline-flex items-center gap-2 mt-4 text-gold hover:text-gold-light font-mono text-xs tracking-wide uppercase transition-colors"
              >
                Submit a quote request
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Disclaimer -->
        <div class="mt-6 pt-6 border-t border-surface-2">
          <p class="font-mono text-muted/60 text-xs leading-relaxed">
            ⚠ {t.scout.disclaimer}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.scout-btn');
  const responseEl = document.getElementById('scout-response');
  const responseText = document.getElementById('scout-response-text');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const response = btn.dataset.response ?? '';

      // Reset all buttons
      buttons.forEach((b) => {
        b.classList.remove('border-gold', 'text-text', 'bg-surface');
        b.classList.add('border-surface-2', 'text-muted');
      });

      // Highlight selected
      btn.classList.add('border-gold', 'text-text', 'bg-surface');
      btn.classList.remove('border-surface-2', 'text-muted');

      // Show response
      if (responseEl && responseText) {
        responseText.textContent = response;
        responseEl.classList.remove('hidden');
        responseEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });
</script>
